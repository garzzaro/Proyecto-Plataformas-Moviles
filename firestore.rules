rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /habitocto_profiles/{tagCode} {
      allow read, write: if true;
    }
    match /habitocto_users/{tagCode} {
      allow read, write: if true;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
  }
}
